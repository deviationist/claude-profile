# claude-profile/.env — per-machine knobs for the shell layer.
#
# Copy to .env next to this file (gitignored). Sourced function-locally by
# the `claude` wrapper on each launch — values never leak into the
# interactive shell's global namespace.

# macOS only: run every `claude` launch under `caffeinate` so the machine
# can't idle-sleep mid-session. Default: 1 (on). Set 0 to opt out.
#CLAUDE_CAFFEINATE=1

# caffeinate flags. Default -ims (idle/disk/system sleep prevented; the
# display may still sleep). Clamshell sleep is NOT prevented on Apple
# Silicon — keep the lid open for long unattended runs.
#CLAUDE_CAFFEINATE_FLAGS=-ims

# Refuse to launch a profile in (or with --add-dir into) a tree it must never
# see. Space-separated "<config-dir>:<forbidden-dir>" pairs; symlinks resolved.
# Example: keep a personal seat out of an employer's checkout tree.
#CLAUDE_FORBID_DIRS="$HOME/.claude-personal:$HOME/work"
